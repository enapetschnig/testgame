{
  "name": "frojach-drive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frojach Drive - ein GTA-artiges Fahrspiel durch Frojach in der Steiermark, gebaut aus echten OpenStreetMap-Daten und Google Street View.",
  "scripts": {
    "dev": "vite",
    "start": "npm run build && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "build:single": "vite build && node scripts/bundle-single.mjs",
    "bake:map": "node scripts/bake-map.mjs"
  },
  "keywords": [
    "threejs",
    "game",
    "openstreetmap",
    "streetview",
    "frojach",
    "steiermark"
  ],
  "license": "MIT",
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^7.3.6"
  }
}
